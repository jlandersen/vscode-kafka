.git
.gitignore
.github/**

# Dependencies
# Keep node_modules in the VSIX: @platformatic/kafka is externalized in webpack
# and loaded at runtime, so excluding node_modules would break activation.
# vsce already limits packaged dependencies to production deps.

# Lock files
package-lock.json
yarn.lock

# Development/Docker
docker-compose.yml
start-cluster.sh
stop-cluster.sh
test-pkcs12.js

# Logs and cache
*.log
.eslintcache
.DS_Store

# Assets (if not needed in package)
assets/**
