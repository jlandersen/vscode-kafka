{
	"name": "vscode-kafka",
	"displayName": "Tools for Apache Kafka®",
	"description": "Interact with Apache Kafka® directly in VS Code",
	"publisher": "jeppeandersen",
	"license": "MIT",
	"version": "0.27.0",
	"engines": {
		"vscode": "^1.101.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jlandersen/vscode-kafka"
	},
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#1d1c1c",
		"theme": "dark"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"kafka"
	],
	"activationEvents": [
		"onCommand:vscode-kafka.open.docs.page",
		"onCommand:vscode-kafka.api.saveclusters",
		"onCommand:vscode-kafka.api.deleteclusters"
	],
	"main": "./dist/extension",
	"contributes": {
		"kafka": {
			"clusterProviders": [
				{
					"id": "vscode-kafka.manual",
					"name": "Configure manually"
				}
			]
		},
		"configuration": {
			"type": "object",
			"title": "Kafka",
			"properties": {
				"kafka.consumers.offset": {
					"type": "string",
					"enum": [
						"earliest",
						"latest"
					],
					"default": "latest",
					"markdownDescription": "Initial offset to read from for new consumers. See [here](command:vscode-kafka.open.docs.page?%5B%7B%22page%22%3A%22Consuming%22%2C%22section%22%3A%22kafkaconsumersoffset%22%7D%5D) for more information."
				},
				"kafka.consumers.headers.print": {
					"type": "boolean",
					"default": "false",
					"markdownDescription": "Print headers of message. See [here](command:vscode-kafka.open.docs.page?%5B%7B%22page%22%3A%22Consuming%22%2C%22section%22%3A%22kafkaconsumersheadersprint%22%7D%5D)"
				},
				"kafka.consumers.messageViewer.maxBufferSize": {
					"type": "number",
					"default": 5000,
					"minimum": 100,
					"markdownDescription": "Maximum number of consumed messages retained in the Message Viewer in-memory session buffer."
				},
				"kafka.explorer.topics.sort": {
					"type": "string",
					"enum": [
						"name",
						"partitions"
					],
					"default": "name",
					"markdownDescription": "Choose sorting for topics in explorer. See [here](command:vscode-kafka.open.docs.page?%5B%7B%22page%22%3A%22Explorer%22%2C%22section%22%3A%22kafkaexplorertopicssort%22%7D%5D) for more information."
				},
				"kafka.explorer.topics.filter": {
					"type": "array",
					"default": [
						"__consumer_offsets",
						"__transaction_state",
						"_schemas",
						"__strimzi*"
					],
					"markdownDescription": "Glob patterns filtering topics out of the Kafka explorer. `*` matches any string, `?` matches a single character. See [here](command:vscode-kafka.open.docs.page?%5B%7B%22page%22%3A%22Explorer%22%2C%22section%22%3A%22kafkaexplorertopicsfilter%22%7D%5D) for more information."
				},
				"kafka.explorer.consumers.filter": {
					"type": "array",
					"default": [
						"strimzi-canary*"
					],
					"markdownDescription": "Glob patterns filtering consumer groups out of the Kafka explorer. `*` matches any string, `?` matches a single character. See [here](command:vscode-kafka.open.docs.page?%5B%7B%22page%22%3A%22Explorer%22%2C%22section%22%3A%22kafkaexplorerconsumersfilter%22%7D%5D) for more information."
				},
				"kafka.producers.fakerjs.enabled": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "Enable injection of [@faker-js/faker](https://fakerjs.dev/api/)-randomized data in record templates, using the mustache syntax. See [here](command:vscode-kafka.open.docs.page?%5B%7B%22page%22%3A%22Producing%22%2C%22section%22%3A%22kafkaproducersfakerjsenabled%22%7D%5D) for more information."
				},
				"kafka.producers.fakerjs.locale": {
					"type": "string",
					"enum": [
						"af_ZA",
						"ar",
						"az",
						"base",
						"cs_CZ",
						"da",
						"de",
						"de_AT",
						"de_CH",
						"dv",
						"el",
						"en",
						"en_AU",
						"en_AU_ocker",
						"en_BORK",
						"en_CA",
						"en_GB",
						"en_GH",
						"en_HK",
						"en_IE",
						"en_IN",
						"en_KE",
						"en_NG",
						"en_US",
						"en_ZA",
						"eo",
						"es",
						"es_MX",
						"fa",
						"fi",
						"fr",
						"fr_BE",
						"fr_CA",
						"fr_CH",
						"fr_LU",
						"fr_SN",
						"he",
						"hr",
						"hu",
						"hy",
						"id_ID",
						"it",
						"ja",
						"ka_GE",
						"ko",
						"lv",
						"mk",
						"nb_NO",
						"ne",
						"nl",
						"nl_BE",
						"pl",
						"pt_BR",
						"pt_PT",
						"ro",
						"ro_MD",
						"ru",
						"sk",
						"sr_RS_latin",
						"sv",
						"th",
						"tr",
						"uk",
						"ur",
						"uz_UZ_latin",
						"vi",
						"yo_NG",
						"zh_CN",
						"zh_TW",
						"zu_ZA"
					],
					"default": "en",
					"markdownDescription": "The locale used to generate [@faker-js/faker](https://fakerjs.dev/api/)-randomized data in record templates. See [here](command:vscode-kafka.open.docs.page?%5B%7B%22page%22%3A%22Producing%22%2C%22section%22%3A%22kafkaproducersfakerjslocale%22%7D%5D) for more information."
				},
				"kafka.clusters": {
					"type": "array",
					"scope": "machine",
					"default": [],
					"markdownDescription": "Kafka cluster configurations. Sensitive credentials (passwords, tokens) are stored securely in the system keychain.",
					"items": {
						"type": "object",
						"required": [
							"id",
							"name",
							"bootstrap"
						],
						"properties": {
							"id": {
								"type": "string",
								"description": "Unique identifier for the cluster"
							},
							"name": {
								"type": "string",
								"description": "Display name for the cluster"
							},
							"bootstrap": {
								"type": "string",
								"description": "Kafka bootstrap servers (comma-separated host:port)"
							},
							"schemaRegistryId": {
								"type": "string",
								"description": "Optional ID of the linked schema registry from kafka.schemaRegistries"
							},
							"clusterProviderId": {
								"type": "string",
								"description": "Optional cluster provider ID for third-party extensions"
							},
							"saslOption": {
								"type": "object",
								"description": "SASL authentication options",
								"required": [
									"mechanism"
								],
								"properties": {
									"mechanism": {
										"type": "string",
										"enum": [
											"plain",
											"scram-sha-256",
											"scram-sha-512",
											"oauthbearer",
											"aws"
										],
										"description": "SASL mechanism"
									},
									"username": {
										"type": "string",
										"description": "Username for plain/scram authentication"
									},
									"oauthTokenEndpoint": {
										"type": "string",
										"description": "OAuth token endpoint URL for OAUTHBEARER"
									},
									"oauthClientId": {
										"type": "string",
										"description": "OAuth client ID for OAUTHBEARER"
									},
									"awsRegion": {
										"type": "string",
										"description": "AWS region for MSK IAM authentication"
									},
									"awsAccessKeyId": {
										"type": "string",
										"description": "AWS access key ID for MSK IAM authentication"
									}
								}
							},
							"ssl": {
								"oneOf": [
									{
										"type": "boolean",
										"description": "Enable/disable SSL"
									},
									{
										"type": "object",
										"description": "SSL configuration options",
										"properties": {
											"ca": {
												"type": "string",
												"description": "Path to CA certificate file"
											},
											"key": {
												"type": "string",
												"description": "Path to client key file"
											},
											"cert": {
												"type": "string",
												"description": "Path to client certificate file"
											},
											"passphrase": {
												"type": "string",
												"description": "Passphrase for encrypted private key"
											},
											"truststore": {
												"type": "string",
												"description": "Path to truststore file in JKS format"
											},
											"truststorePassword": {
												"type": "string",
												"description": "Password for truststore"
											},
											"rejectUnauthorized": {
												"type": "boolean",
												"description": "Verify SSL certificate hostname",
												"default": true
											}
										}
									}
								]
							}
						}
					}
				},
				"kafka.schemaRegistries": {
					"type": "array",
					"scope": "machine",
					"default": [],
					"markdownDescription": "Schema Registry connection configurations. Sensitive credentials (passwords) are stored securely in the system keychain.",
					"items": {
						"type": "object",
						"required": [
							"id",
							"name",
							"connection"
						],
						"properties": {
							"id": {
								"type": "string",
								"description": "Unique identifier for the schema registry"
							},
							"name": {
								"type": "string",
								"description": "Display name for the schema registry"
							},
							"connection": {
								"type": "object",
								"required": [
									"url"
								],
								"properties": {
									"url": {
										"type": "string",
										"description": "Schema Registry base URL"
									},
									"namingStrategy": {
										"type": "string",
										"enum": [
											"TopicNameStrategy",
											"RecordNameStrategy",
											"TopicRecordNameStrategy"
										],
										"default": "TopicNameStrategy",
										"description": "Subject naming strategy used for topic subject discovery"
									},
									"auth": {
										"type": "object",
										"required": [
											"username"
										],
										"properties": {
											"username": {
												"type": "string",
												"description": "Basic auth username"
											},
											"password": {
												"type": "string",
												"description": "Basic auth password (stored securely after save through UI)"
											}
										}
									},
									"tls": {
										"type": "object",
										"properties": {
											"ca": {
												"type": "string",
												"description": "Path to CA certificate file"
											},
											"cert": {
												"type": "string",
												"description": "Path to client certificate file"
											},
											"key": {
												"type": "string",
												"description": "Path to client key file"
											},
											"passphrase": {
												"type": "string",
												"description": "Passphrase for encrypted private key"
											},
											"rejectUnauthorized": {
												"type": "boolean",
												"default": true,
												"description": "Verify SSL certificate hostname"
											}
										}
									}
								}
							}
						}
					}
				},
				"kafka.clusters.selected": {
					"type": "string",
					"scope": "window",
					"default": "",
					"markdownDescription": "ID of the currently selected Kafka cluster"
				}
			}
		},
		"languages": [
			{
				"id": "kafka",
				"extensions": [
					".kafka"
				],
				"aliases": [
					"kafka"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "kafka",
				"scopeName": "source.kafka",
				"path": "./syntaxes/kafka.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "kafka",
				"path": "./snippets/producers.json"
			},
			{
				"language": "kafka",
				"path": "./snippets/consumers.json"
			}
		],
		"jsonValidation": [
			{
				"fileMatch": "package.json",
				"url": "./schemas/package.schema.json"
			}
		],
		"commands": [
			{
				"command": "vscode-kafka.inline.activate",
				"title": "Inline activate - produce or start/stop consumer",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.open.docs.home",
				"title": "Open Documentation",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.explorer.addcluster",
				"title": "Add Cluster",
				"category": "Kafka",
				"icon": {
					"light": "images/light/add.svg",
					"dark": "images/dark/add.svg"
				}
			},
			{
				"command": "vscode-kafka.explorer.copylabel",
				"title": "Copy Label",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.explorer.deleteselected",
				"title": "Delete",
				"category": "Kafka",
				"icon": {
					"light": "images/light/trashcan.svg",
					"dark": "images/dark/trashcan.svg"
				}
			},
			{
				"command": "vscode-kafka.cluster.delete",
				"title": "Delete Cluster",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.explorer.refresh",
				"title": "Refresh",
				"category": "Kafka",
				"icon": {
					"light": "images/light/refresh.svg",
					"dark": "images/dark/refresh.svg"
				}
			},
			{
				"command": "vscode-kafka.schemaRegistry.refresh",
				"title": "Refresh Schema Registry",
				"category": "Kafka",
				"icon": {
					"light": "images/light/refresh.svg",
					"dark": "images/dark/refresh.svg"
				}
			},
			{
				"command": "vscode-kafka.schemaRegistry.retry",
				"title": "Retry Schema Registry",
				"category": "Kafka",
				"icon": {
					"light": "images/light/refresh.svg",
					"dark": "images/dark/refresh.svg"
				}
			},
			{
				"command": "vscode-kafka.schemaRegistry.add",
				"title": "Add Schema Registry",
				"category": "Kafka",
				"icon": {
					"light": "images/light/add.svg",
					"dark": "images/dark/add.svg"
				}
			},
			{
				"command": "vscode-kafka.schemaRegistry.edit",
				"title": "Edit Schema Registry",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.schemaRegistry.delete",
				"title": "Delete Schema Registry",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.schemaRegistry.linkCluster",
				"title": "Link Cluster to Schema Registry",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.schemaRegistry.unlinkCluster",
				"title": "Unlink Cluster from Schema Registry",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.schemaRegistry.openSettings",
				"title": "Open Schema Registry Settings",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.schemaRegistry.openVersion",
				"title": "Open Schema Version",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.schemaRegistry.compareVersions",
				"title": "Compare Schema Versions",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.explorer.createtopic",
				"title": "Create Topic",
				"category": "Kafka",
				"icon": {
					"light": "images/light/add.svg",
					"dark": "images/dark/add.svg"
				}
			},
			{
				"command": "vscode-kafka.explorer.dumptopicmetadata",
				"title": "Dump Topic Metadata",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.topic.delete",
				"title": "Delete Topic",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.topic.deleterecords",
				"title": "Delete Records",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.explorer.dumpbrokermetadata",
				"title": "Dump Broker Metadata",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.explorer.dumpclustermetadata",
				"title": "Dump Cluster Metadata",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.explorer.selectcluster",
				"title": "Select Cluster",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.explorer.editcluster",
				"title": "Edit Cluster",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.consumer.start",
				"title": "Start Consumer (UTF-8 record values)",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.consumer.stop",
				"title": "Stop Consumer",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.consumer.list",
				"title": "View Consumers",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.consumer.deletegroup",
				"title": "Delete Consumer Group",
				"category": "Kafka"
			},
			{
				"command": "vscode-kafka.discover.clusterproviders",
				"title": "Discover Cluster Providers",
				"category": "Kafka",
				"icon": "$(extensions)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "vscode-kafka.explorer.refresh",
					"when": "view == kafkaExplorer",
					"group": "navigation"
				},
				{
					"command": "vscode-kafka.explorer.addcluster",
					"when": "view == kafkaExplorer",
					"group": "navigation"
				},
				{
					"command": "vscode-kafka.discover.clusterproviders",
					"when": "view == kafkaExplorer",
					"group": "navigation"
				},
				{
					"command": "vscode-kafka.schemaRegistry.refresh",
					"when": "view == kafkaSchemaRegistriesExplorer",
					"group": "navigation"
				},
				{
					"command": "vscode-kafka.schemaRegistry.add",
					"when": "view == kafkaSchemaRegistriesExplorer",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "vscode-kafka.explorer.createtopic",
					"when": "view == kafkaExplorer && viewItem == topics && !listMultiSelection",
					"group": "inline"
				},
				{
					"command": "vscode-kafka.consumer.start",
					"when": "view == kafkaExplorer && viewItem == topic && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.explorer.dumptopicmetadata",
					"when": "view == kafkaExplorer && viewItem == topic && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.schemaRegistry.refresh",
					"when": "view == kafkaExplorer && viewItem =~ /^schemaregistries$|^schemaregistry$|^schemasubject$/ && !listMultiSelection",
					"group": "inline"
				},
				{
					"command": "vscode-kafka.schemaRegistry.refresh",
					"when": "view == kafkaSchemaRegistriesExplorer && viewItem == schemaregistryconnection && !listMultiSelection",
					"group": "inline"
				},
				{
					"command": "vscode-kafka.schemaRegistry.edit",
					"when": "view == kafkaSchemaRegistriesExplorer && viewItem == schemaregistryconnection && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.schemaRegistry.linkCluster",
					"when": "view == kafkaSchemaRegistriesExplorer && viewItem == schemaregistryconnection && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.schemaRegistry.unlinkCluster",
					"when": "view == kafkaSchemaRegistriesExplorer && viewItem == schemaregistryconnection && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.schemaRegistry.delete",
					"when": "view == kafkaSchemaRegistriesExplorer && viewItem == schemaregistryconnection && !listMultiSelection",
					"group": "3_modification"
				},
				{
					"command": "vscode-kafka.schemaRegistry.retry",
					"when": "view == kafkaExplorer && viewItem == schemaregistryerror && !listMultiSelection",
					"group": "inline"
				},
				{
					"command": "vscode-kafka.schemaRegistry.openSettings",
					"when": "view == kafkaExplorer && viewItem == schemaregistryerror && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.schemaRegistry.openVersion",
					"when": "view == kafkaExplorer && viewItem == schemaversion && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.schemaRegistry.compareVersions",
					"when": "view == kafkaExplorer && viewItem =~ /^schemasubject$|^schemaversion$/ && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.topic.deleterecords",
					"when": "view == kafkaExplorer && viewItem == topic && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.explorer.dumpclustermetadata",
					"when": "view == kafkaExplorer && viewItem == broker && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.explorer.dumpbrokermetadata",
					"when": "view == kafkaExplorer && viewItem == broker && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.explorer.selectcluster",
					"when": "view == kafkaExplorer && viewItem =~ /^cluster.*$/ && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.explorer.editcluster",
					"when": "view == kafkaExplorer && viewItem =~ /^cluster$|^selectedCluster$/ && !listMultiSelection",
					"group": "1_kafka"
				},
				{
					"command": "vscode-kafka.explorer.copylabel",
					"when": "view == kafkaExplorer",
					"group": "2_cutcopypaste"
				},
				{
					"command": "vscode-kafka.explorer.deleteselected",
					"when": "view == kafkaExplorer && viewItem =~ /^cluster.*$|^selectedCluster.*$|^topic$|^consumergroupitem$/ && !listMultiSelection",
					"group": "inline"
				},
				{
					"command": "vscode-kafka.explorer.deleteselected",
					"when": "view == kafkaExplorer && viewItem =~ /^cluster.*$|^selectedCluster.*$|^topic$|^consumergroupitem$/ && !listMultiSelection",
					"group": "3_modification"
				},
				{
					"command": "vscode-kafka.explorer.deleteselected",
					"when": "view == kafkaExplorer && viewItem == topic && listMultiSelection",
					"group": "3_modification"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"icon": "images/kafka.svg",
					"id": "kafkaView",
					"title": "Kafka"
				}
			]
		},
		"views": {
			"kafkaView": [
				{
					"id": "kafkaExplorer",
					"name": "Clusters"
				},
				{
					"id": "kafkaSchemaRegistriesExplorer",
					"name": "Schema Registries"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "kafkaExplorer",
				"contents": "No Kafka clusters found.\n[Add new cluster](command:vscode-kafka.explorer.addcluster)"
			},
			{
				"view": "kafkaSchemaRegistriesExplorer",
				"contents": "No schema registries configured.\n[Add schema registry](command:vscode-kafka.schemaRegistry.add)"
			}
		],
		"keybindings": [
			{
				"command": "vscode-kafka.explorer.copylabel",
				"key": "Ctrl+C",
				"mac": "Cmd+C",
				"when": "focusedView == kafkaExplorer"
			},
			{
				"command": "vscode-kafka.explorer.deleteselected",
				"key": "delete",
				"mac": "cmd+backspace",
				"when": "focusedView == kafkaExplorer && !listMultiSelection"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"run-extension": "npm run compile && code --new-window --extensionDevelopmentPath=\"$PWD\" --user-data-dir \"$PWD/.vscode-test\" --extensions-dir \"$PWD/.vscode-test/extensions\" \"$PWD\"",
		"run-extension:watch": "npm run watch & code --new-window --extensionDevelopmentPath=\"$PWD\" --user-data-dir \"$PWD/.vscode-test\" --extensions-dir \"$PWD/.vscode-test/extensions\" \"$PWD\"",
		"compile": "webpack --config ./build/node-extension.webpack.config.js",
		"watch": "webpack --watch --config ./build/node-extension.webpack.config.js",
		"package": "webpack --mode production --devtool hidden-source-map --config ./build/node-extension.webpack.config.js",
		"test-compile": "tsc -p ./",
		"test-watch": "tsc -watch -p ./",
		"pretest": "npm run test-compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"test:integration": "node ./out/test/runIntegrationTest.js",
		"pretest:integration": "npm run test-compile"
	},
